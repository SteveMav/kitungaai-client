# Copy this file to .env on the Raspberry Pi, then set the two values below.
# Do not commit .env: DEVICE_SECRET authenticates this physical device.
API_MODE=real
API_BASE_URL=http://stevemavuela.local:8000
DEVICE_ID=KITUNGA-PI-001
DEVICE_SECRET=COLLER_ICI_LE_SECRET_AFFICHE_PAR_PROVISION_DEVICE

# Keep these settings if the RFID reader and hardware are connected.
RFID_MODE=hardware
HARDWARE_ENABLED=true
MATRIX_ENABLED=true
PREVIEW_ENABLED=true
