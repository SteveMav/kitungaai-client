# Copy this file to .env on the Raspberry Pi, then set its device identifier.
API_MODE=real
API_BASE_URL=http://stevemavuela.local:8000
DEVICE_ID=KITUNGA-PI-001

# Keep these settings if the RFID reader and hardware are connected.
RFID_MODE=hardware
HARDWARE_ENABLED=true
MATRIX_ENABLED=true
# MAX7219 8x8 on SPI0 CE0: CLK=GPIO11, CS=GPIO8, DIN/MOSI=GPIO10.
MATRIX_DEVICE=/dev/spidev0.0
MATRIX_CASCADED=1
PREVIEW_ENABLED=true
PREVIEW_HOST=0.0.0.0
PREVIEW_PORT=5000
